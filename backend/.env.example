# Copy to .env for local overrides. Everything except TOMTOM_API_KEY has a safe dev default.

# Required: truck routing (free key at developer.tomtom.com, no card needed)
TOMTOM_API_KEY=

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# CORS (no auth/cookies are used, so all origins are allowed by default)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional provider overrides (e.g. a proxy if the weather API rate-limits your host's IP)
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
# PHOTON_URL=https://photon.komoot.io/api/
